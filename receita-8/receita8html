      <script src="tabela.js"></script>

      <script>
         const API_BASE = "https://random-data-api.com/api/v2"

         // Consumo da API utilizando Promise / then / catch
         const carregarCervejas = () => {
            fetch(`${API_BASE}/beers?size=5`)
               .then(res => res.json())
               .then(dados => {
                  montarTabela(
