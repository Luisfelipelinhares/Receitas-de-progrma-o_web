<!DOCTYPE html>
<html lang="pt-BR">
   <head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>Catálogo Genérico via API</title>
      <style>
         * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
         }

         body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #0f172a;
            color: #f8fafc;
            padding: 40px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
         }

         h1 {
            margin-bottom: 24px;
            font-weight: 600;
            color: #38bdf8;
            text-align: center;
         }

         .controles {
            display: flex;
            gap: 12px;
            margin-bottom: 30px;
            flex-wrap: wrap;
            justify-content: center;
         }

         button {
            background-color: #1e293b;
            color: #e2e8f0;
            border: 1px solid #334155;
            padding: 12px 24px;
            font-size: 15px;
            font-weight: 500;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease-in-out;
         }

         button:hover {
            background-color: #0284c7;
            border-color: #38bdf8;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(2, 132, 199, 0.3);
         }

         #conteudoDiv {
            width: 100%;
            max-width: 900px;
            overflow-x: auto;
         }

         .tabela-generica {
            width: 100%;
            border-collapse: collapse;
            background-color: #1e293b;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
         }

         .tabela-generica th {
            background-color: #0369a1;
            color: #ffffff;
            padding: 14px 18px;
            text-align: left;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
         }

         .tabela-generica td {
            padding: 14px 18px;
            border-bottom: 1px solid #334155;
            color: #cbd5e1;
            font-size: 15px;
         }

         .tabela-generica tr:last-child td {
            border-bottom: none;
         }

         .tabela-generica tr:nth-child(even) {
            background-color: #182232;
         }

         .tabela-generica tr:hover {
            background-color: #334155;
         }

         .mensagem-alerta {
            text-align: center;
            color: #f43f5e;
            font-size: 16px;
            padding: 20px;
         }
      </style>
   </head>

   <body>
      <h1>Explorador de Dados</h1>

      <div class="controles">
         <button id="btnCervejas">Carregar Cervejas</button>
         <button id="btnCafes">Carregar Cafés</button>
         <button id="btnUsuarios">Carregar Usuários</button>
      </div>

      <div id="conteudoDiv"></div>

      <!-- Importação do script separado com a função genérica -->
      <script src="tabela.js"></script>

      <script>
         const API_BASE = "https://random-data-api.com/api/v2"

         const carregarCervejas = async () => {
            try {
               const res = await fetch(`${API_BASE}/beers?size=5`)
               const dados = await res.json()
               
               montarTabela(
                  dados,
                  "conteudoDiv",
                  ["Nome", "Marca", "Estilo", "Teor Alcoólico", "IBU"],
                  ["name", "brand", "style", "alcohol", "ibu"]
               )
            } catch (err) {
               document.getElementById("conteudoDiv").innerHTML = "<p class='mensagem-alerta'>Erro ao carregar cervejas.</p>"
            }
         }

         const carregarCafes = async () => {
            try {
               const res = await fetch(`${API_BASE}/coffee?size=5`)
               const dados = await res.json()

               montarTabela(
                  dados,
                  "conteudoDiv",
                  ["Variedade", "Origem", "Torra", "Notas de Gustação"],
                  ["blend_name", "origin", "roast", "notes"]
               )
            } catch (err) {
               document.getElementById("conteudoDiv").innerHTML = "<p class='mensagem-alerta'>Erro ao carregar cafés.</p>"
            }
         }

         const carregarUsuarios = async () => {
            try {
               const res = await fetch(`${API_BASE}/users?size=5`)
               const dados = await res.json()

               montarTabela(
                  dados,
                  "conteudoDiv",
                  ["Nome", "Sobrenome", "E-mail", "Gênero"],
                  ["first_name", "last_name", "email", "gender"]
               )
            } catch (err) {
               document.getElementById("conteudoDiv").innerHTML = "<p class='mensagem-alerta'>Erro ao carregar usuários.</p>"
            }
         }

         document.getElementById("btnCervejas").addEventListener("click", carregarCervejas)
         document.getElementById("btnCafes").addEventListener("click", carregarCafes)
         document.getElementById("btnUsuarios").addEventListener("click", carregarUsuarios)
      </script>
   </body>
</html>